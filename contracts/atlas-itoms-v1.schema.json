              }
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "publicationId",
        "approvedExportRef",
        "publicationApprovalRef",
        "atlasPins",
        "purpose"
      ],
      "additionalProperties": false
